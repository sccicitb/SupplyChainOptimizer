# Salin file ini menjadi `.env` lalu isi nilainya.

# WAJIB. Kebijakan Nominatim (OpenStreetMap) mensyaratkan alamat kontak yang valid
# pada User-Agent setiap request. Tanpa ini request Anda bisa diblokir.
CONTACT_EMAIL=email-anda@contoh.com

# Port server proxy.
PORT=5174

# --- OPSIONAL: semua fitur di bawah punya fallback tanpa API key ---

# SerpAPI dipakai untuk DUA hal sekaligus:
#   1. Pencarian pemasok di Google Maps (sumber utama; cakupan badan usaha di
#      Indonesia jauh melampaui OpenStreetMap, dan hasilnya membawa rating asli)
#   2. Pencarian profil perusahaan lewat Google Search
# Tanpa key: pemasok dicari di OpenStreetMap, profil lewat DuckDuckGo.
#
# Kuota: free plan 250 pencarian/bulan. Satu analisis penuh memakai sekitar
# 6 pencarian, jadi kira-kira 40 analisis per bulan. Hasil di-cache, sehingga
# menganalisis ulang perusahaan yang sama tidak menagih kuota lagi.
SERPAPI_KEY=

# Sumber pencarian pemasok:
#   auto   - Google Maps utama, OpenStreetMap cadangan (disarankan)
#   google - Google Maps saja; berhenti bekerja bila kuota habis
#   osm    - OpenStreetMap saja; gratis tanpa batas, cakupan lebih tipis
SUPPLIER_SOURCE=auto

# Penurunan Bill of Materials dari model bisnis hasil scraping.
# Tanpa key, sistem memakai aturan taksonomi kata kunci (deterministik).
# Dengan key, Claude menurunkan BOM secara semantik.
ANTHROPIC_API_KEY=

# Endpoint Overpass. Default overpass-api.de sering sibuk; alternatif:
# https://overpass.kumi.systems/api/interpreter
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter

# Matikan cache disk saat debugging (default: aktif)
DISABLE_DISK_CACHE=
