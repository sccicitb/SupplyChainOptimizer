{
  "name": "ai-supply-chain-optimizer",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node --watch server/index.js",
    "start": "concurrently -n server,web -c magenta,cyan \"npm:server\" \"npm:dev\"",
    "test": "node test/mcdm.test.mjs",
    "build": "vite build",
    "start:prod": "cross-env NODE_ENV=production node server/index.js",
    "preview": "vite preview",
    "postinstall": "cd server && npm install --no-audit --no-fund"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^10.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7"
  }
}
